# Build output
build/
bin/
*.exe
*.dcu
*.ppu
*.o
*.a
*.compiled
*.map
*.res

# Delphi IDE artifacts. No .dproj is tracked: opening a .dpr makes the IDE
# generate one for whatever Delphi version is installed, which is what lets
# XE7 and Delphi 12 open the same checkout.
*.dproj
*.dproj.local
*.local
*.identcache
*.dsk
*.stat
*.tvsconfig
*.rsm
*.drc
__history/
__recovery/
Win32/
Win64/

# Boss
modules/
boss-lock.json

# Editors
.vscode/
.idea/
